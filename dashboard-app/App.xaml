<Application x:Class="ScreenRecall.Dashboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1B1F27" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF232833" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4FA3FF" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFFF9F45" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8ECF4" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#FF39404F" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Margin" Value="0,2,0,6" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#FF39404F" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </Application.Resources>
</Application>
