<Window x:Class="ScreenRecall.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenRecall.Dashboard"
        Title="Screen Recall — dashboard" Height="820" Width="1300"
        Background="{StaticResource SurfaceBrush}"
        Closing="OnClosing" Loaded="OnLoaded" SourceInitialized="OnSourceInitialized">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Recorded days -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource PanelBrush}"
            Padding="10" Margin="0,0,10,10" CornerRadius="6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Recorded days" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="Refresh days" Click="OnRefreshDays" />
          <Button Content="Open storage folder" Click="OnOpenStorage" />
        </StackPanel>
        <ListBox x:Name="DayList" Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource TextBrush}" SelectionChanged="OnDaySelected"
                 DisplayMemberPath="Display" />
      </DockPanel>
    </Border>

    <!-- Playback controls -->
    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource PanelBrush}"
            Padding="10" Margin="0,0,10,10" CornerRadius="6">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="PlayButton" Content="▶ Play" Width="90" Click="OnPlayPause" />
          <Button Content="⏮ Prev day" Click="OnPreviousDay" />
          <Button Content="Next day ⏭" Click="OnNextDay" />
          <TextBlock x:Name="PositionText" VerticalAlignment="Center" Margin="10,0,0,0"
                     Text="--:--:--.---" FontFamily="Consolas" />
          <TextBlock x:Name="PlaybackInfoText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#FF9AA6BB" />
        </StackPanel>

        <Slider x:Name="Scrubber" Minimum="0" Maximum="1000" Margin="0,10,0,4"
                ValueChanged="OnScrub" Thumb.DragStarted="OnScrubStart" Thumb.DragCompleted="OnScrubEnd" />

        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox x:Name="SpeedBox" Width="80" SelectedIndex="1" SelectionChanged="OnSpeedChanged">
            <ComboBoxItem Content="0.5x" />
            <ComboBoxItem Content="1x" />
            <ComboBoxItem Content="2x" />
            <ComboBoxItem Content="4x" />
            <ComboBoxItem Content="8x" />
          </ComboBox>
          <Button Content="◀ step" Margin="16,0,6,6" Click="OnStepBack" />
          <Button Content="step ▶" Click="OnStepForward" />
          <Button Content="Save PNG" Click="OnSaveFrame" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Reconstructed frame -->
    <Border Grid.Row="1" Grid.Column="1" Background="#FF0F1218" Margin="0,0,10,10" CornerRadius="6">
      <Grid>
        <Image x:Name="FrameImage" Stretch="Uniform" />
        <TextBlock x:Name="FramePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#FF7A879B" Text="Select a recorded day to load the timeline" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- Jump to focus -->
    <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource PanelBrush}"
            Padding="10" Margin="0,0,10,0" CornerRadius="6">
      <DockPanel Height="140">
        <TextBlock DockPanel.Dock="Top" Text="Jump to next focus (navigation metadata, not analytics)"
                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox x:Name="FocusList" Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource TextBrush}" DisplayMemberPath="Display"
                 MouseDoubleClick="OnFocusDoubleClick" />
      </DockPanel>
    </Border>

    <!-- Status and settings -->
    <local:SettingsPanel x:Name="Settings" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" />
  </Grid>
</Window>
