<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScreenRecall.Dashboard</RootNamespace>
    <AssemblyName>ScreenRecall.Dashboard</AssemblyName>
    <!-- WPF text rendering needs real cultures (font fallback); the repo-wide invariant
         default in Directory.Build.props breaks it. The service/CLI keep invariant mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\player-lib\ScreenRecall.Player.csproj" />
    <ProjectReference Include="..\storage-lib\ScreenRecall.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

</Project>
